{
  "name": "coptic-ios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:lan": "next dev --webpack --hostname 0.0.0.0",
    "build": "node scripts/clean-export-output.mjs && next build --webpack",
    "start": "serve out --listen 3000",
    "start:lan": "npm run start",
    "preview:phone": "npm run build && serve out --listen 3000",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:translation-assets": "node scripts/check-translation-assets.mjs",
    "test:mobile": "node scripts/mobile-smoke.mjs",
    "test:settings-navigation": "node scripts/settings-navigation-smoke.mjs",
    "test:routes": "node scripts/route-preparation-smoke.mjs",
    "prebuild": "node scripts/local-translation/copy-runtime.mjs && node scripts/scanner/prepare.mjs",
    "postbuild": "node scripts/settle-static-html.mjs",
    "test:backup": "node scripts/progress-backup-smoke.mjs"
  },
  "dependencies": {
    "@capacitor/app": "7.1.2",
    "@capacitor/camera": "^7.0.3",
    "@capacitor/cli": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@coptic/secure-auth-storage": "file:plugins/secure-auth-storage",
    "@huggingface/transformers": "3.8.1",
    "@supabase/supabase-js": "latest",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.4.2",
    "fuse.js": "^7.1.0",
    "next": "16.1.6",
    "react": "^18",
    "react-dom": "^18",
    "tesseract.js": "^6.0.1",
    "unzipper": "^0.12.3",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.2.0",
    "playwright": "1.64.0",
    "postcss": "^8",
    "serve": "14.2.6",
    "tailwindcss": "^3",
    "typescript": "^5"
  }
}

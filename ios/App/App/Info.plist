    <string>Photograph Coptic text to recognise and translate it on your device.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Choose a photo of Coptic text to recognise and translate on your device.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Allow photo access for the Coptic scanner.</string>
